    "/v1/lyrics/candidates": {
      "get": {
        "operationId": "getLyricCandidates",
        "parameters": [
          {
            "in": "query",
            "name": "title",
            "required": true,
            "schema": {
              "maxLength": 300,
              "minLength": 1,
              "title": "Title",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "artist",
            "required": true,
            "schema": {
              "maxLength": 300,
              "minLength": 1,
              "title": "Artist",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "duration_seconds",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "maximum": 3600,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Duration Seconds"
            }
          },
          {
            "in": "query",
            "name": "album",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 300,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Album"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LyricCandidateResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
